# Telegram Bot Settings
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist: Comma-separated list of numeric Telegram User IDs allowed to access this bot.
# Obtain your ID from @userinfobot on Telegram.
ALLOWED_TELEGRAM_USER_IDS=123456789

# Groq API Key
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Gmail OAuth Credentials
# Path to your downloaded client secret JSON file from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials/credentials.json
GMAIL_TOKEN_PATH=credentials/token.json

# Daily Digest Schedule (24-hour format: HH:MM in local time, e.g. 08:30)
DAILY_DIGEST_TIME=08:30
# Auto-digest enabled on startup (true/false)
ENABLE_SCHEDULED_DIGEST=true
# Chat ID to receive the daily digest (usually your own Telegram User ID)
DIGEST_CHAT_ID=123456789
